---
import personalData from '../data/personal.json';
import profiles from '../data/profiles.json';

const socialLinks = [
  { label: 'GitHub', url: profiles.github, icon: 'simple-icons:github' },
  { label: 'LinkedIn', url: profiles.linkedin, icon: 'mdi:linkedin' },
  { label: 'ResearchGate', url: profiles.researchgate, icon: 'simple-icons:researchgate' },
  { label: 'Google Scholar', url: profiles.googlescholar, icon: 'simple-icons:googlescholar' },
].filter((link) => link.url);
---

<section id="contact" class="py-24" style="background: var(--bg-section); position: relative; z-index: 5; scroll-margin-top: 80px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">Contact me</p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">Let's talk.</h2>
      </div>

      <div class="contact-cards">
        {personalData.email && (
          <div class="card contact-card">
            <div class="contact-icon" aria-hidden="true">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3>Email</h3>
            <p>Get in touch about research, opportunities, or collaboration.</p>
            <a href={`mailto:${personalData.email}`} class="contact-email">{personalData.email}</a>
          </div>
        )}

        {socialLinks.length > 0 && (
          <div class="card contact-card">
            <h3>Where else you can find me</h3>
            <div class="contact-profiles">
              {socialLinks.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="contact-social-link">
                  <iconify-icon icon={link.icon} width="22" height="22" aria-hidden="true" />
                  <span>{link.label}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-cards { display: flex; flex-wrap: wrap; gap: 2rem; }
  .contact-card { flex: 1 1 18rem; min-width: 0; }
  .contact-card h3 { color: var(--text, #f8fafc); font-size: 1.125rem; font-weight: 600; margin-bottom: 1rem; }
  .contact-card p { color: var(--text-muted, #94a3b8); font-size: 0.9375rem; line-height: 1.7; margin-bottom: 1rem; }
  .contact-icon { color: var(--accent, #38bdf8); margin-bottom: 1rem; }
  .contact-email { color: var(--accent, #38bdf8); overflow-wrap: anywhere; }
  .contact-profiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .contact-social-link { color: var(--text-muted, #94a3b8); display: flex; align-items: center; gap: 0.65rem; min-height: 44px; font-size: 0.9375rem; }
  .contact-social-link iconify-icon { flex-shrink: 0; }
  .contact-social-link:hover, .contact-email:hover { color: var(--accent, #38bdf8); text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--accent, #38bdf8); outline-offset: 4px; border-radius: 0.25rem; }
  @media (max-width: 380px) { .contact-profiles { grid-template-columns: 1fr; } }
</style>
