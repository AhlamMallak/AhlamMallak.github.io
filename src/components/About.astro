---
import personalData from '../data/personal.json';

// Add dates and image paths here as we complete your timeline.
// Entries appear in the order listed.
const timeline = [
  {
    dates: '',
    title: "Master’s Research",
    institution: 'South Korea',
    description:
      "Machine learning and medical image processing for Alzheimer’s disease computer-aided diagnosis.",
    image: '',
    imageAlt: '',
  },
  {
    dates: '',
    title: 'PhD · Electrical & Computer Engineering',
    institution: 'University of Siegen',
    description:
      'Machine learning and deep learning for sensor and component fault detection, diagnosis and predictive maintenance in Industry 4.0 systems.',
    image: '',
    imageAlt: '',
  },
  {
    dates: '',
    title: 'Postdoctoral Research',
    institution: 'Goethe University Frankfurt',
    description:
      'Biomedical data analytics and computational bioinformatics, including heritability analysis and analytical workflows for genetics and epigenetics research.',
    image: '',
    imageAlt: '',
  },
];
---

<section
  id="about"
  class="py-24 bg-slate-900/30"
  style="scroll-margin-top: 80px;"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12 reveal">
        <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">
          Research · Engineering · Curiosity
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">
          About / CV
        </h2>
      </div>

      <div class="card reveal">
        <p class="text-lg text-slate-300 leading-relaxed">
          {personalData.aboutLong}
        </p>

        <hr class="gradient-divider my-8" />

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <dt class="text-white font-semibold mb-2">Focus</dt>
            <dd class="text-slate-300 leading-relaxed">
              {personalData.title}
            </dd>
          </div>

          <div>
            <dt class="text-white font-semibold mb-2">Based in</dt>
            <dd class="text-slate-300">{personalData.location}</dd>
          </div>

          <div>
            <dt class="text-white font-semibold mb-2">Education</dt>
            <dd class="text-slate-300 leading-relaxed">
              {personalData.education}
            </dd>
          </div>

          {
            personalData.yearsExperience && (
              <div>
                <dt class="text-white font-semibold mb-2">Experience</dt>
                <dd class="text-slate-300">
                  {personalData.yearsExperience} years
                </dd>
              </div>
            )
          }
        </dl>

        {
          personalData.cv && (
            <a
              href={personalData.cv}
              class="cv-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Download CV
            </a>
          )
        }
      </div>

      <div class="mt-16">
        <h3 class="text-2xl sm:text-3xl font-bold text-white mb-10 reveal">
          My path through research
        </h3>

        <ol class="career-timeline">
          {
            timeline.map((entry) => (
              <li class="timeline-entry reveal">
                <span class="timeline-dot" aria-hidden="true" />

                <article class="card timeline-card">
                  {entry.image && (
                    <img
                      src={entry.image}
                      alt={entry.imageAlt}
                      class="timeline-image"
                      loading="lazy"
                      width="800"
                      height="500"
                    />
                  )}

                  <div>
                    {entry.dates && (
                      <p class="text-highlight font-semibold mb-2">
                        {entry.dates}
                      </p>
                    )}
                    <h4 class="text-xl font-bold text-white mb-2">
                      {entry.title}
                    </h4>
                    <p class="text-accent font-medium mb-3">
                      {entry.institution}
                    </p>
                    <p class="text-slate-300 leading-relaxed">
                      {entry.description}
                    </p>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .career-timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 2px solid rgb(148 163 184 / 30%);
  }

  .timeline-entry {
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline-entry:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: calc(-1.5rem - 8px);
    top: 1.75rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: currentColor;
    color: rgb(148 163 184);
    box-shadow: 0 0 0 5px rgb(15 23 42);
  }

  .timeline-card {
    display: grid;
    gap: 1.5rem;
    overflow: hidden;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .timeline-image {
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  .cv-link {
    display: inline-block;
    margin-top: 1.75rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    color: white;
    font-weight: 600;
  }

  .cv-link:hover {
    background: rgb(255 255 255 / 8%);
  }

  .cv-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (min-width: 640px) {
    .timeline-card:has(.timeline-image) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #about .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const elements = document.querySelectorAll('#about .reveal');

  if (
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    !('IntersectionObserver' in window)
  ) {
    elements.forEach((element) => element.classList.add('visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    elements.forEach((element) => observer.observe(element));
  }
</script>
